# evidata — environment configuration. Copy to .env.local for local dev.
# Everything here is optional: with nothing set, the app runs the FixtureProvider
# over an in-memory Sample (great for a demo), with no persistence and no auth wall.

# --- AI provider (spec 03/13) -------------------------------------------------
# Use a real OpenAI-compatible model instead of the deterministic fixtures.
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=sk-...                 # or DEEPSEEK_API_KEY
# OPENAI_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-chat

# --- Metadata store (spec 08 §9 / 12 §4) --------------------------------------
# Where evidata stores its OWN data (investigations, answers, users, connections).
# Default: in-memory (resets on restart). For a real self-hosted deploy, persist it:
#
#   File-backed pglite (simplest — one directory, no separate database to run):
# METADATA_DATA_DIR=/var/lib/evidata/metadata
#
#   …or a real Postgres host (planned — the node-postgres runtime client +
#   deploy-time db:migrate are a tracked follow-up):
# METADATA_DATABASE_URL=postgres://user:pass@host:5432/evidata_meta
#
# Metadata MUST be isolated from any business database (separate DB + credentials).

# --- Credential vault (spec 08 §3) --------------------------------------------
# Required to create real Connections — encrypts their credentials at rest.
# A base64-encoded 32-byte key, e.g. `openssl rand -base64 32`.
# APP_ENCRYPTION_KEY=

# --- Connection/introspection integration tests (CI + local) ------------------
# A throwaway Postgres for the gated @evidata/connector-postgres / introspection
# tests (see docker-compose.yml). Unset → those tests skip.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/evidata_test
